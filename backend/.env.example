DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/studyquest
# Opcional em desenvolvimento; sem valor, o backend gera um segredo temporário.
# Defina um segredo aleatório persistente para manter sessões após reiniciar.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_GENERATION_ENABLED=false
OPENAI_MODEL=gpt-4o-mini
